{
  "manifest_version": 3,
  "name": "Mesos Watch Alerts",
  "version": "1.0.0",
  "description": "Watchlist and price alerts for mesos.watch. Runs inside an open mesos.watch tab using the site's own session.",
  "permissions": ["storage", "notifications", "alarms"],
  "host_permissions": ["https://mesos.watch/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://mesos.watch/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mesos.watch/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mesos Watch Alerts",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
